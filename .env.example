# SmartChat 环境变量配置
# 复制此文件为 .env 后修改

# 鉴权配置
CHAINLIT_AUTH_SECRET=please_replace_this_with_a_secure_random_string_at_least_32_bytes
SMARTCHAT_USER=admin
SMARTCHAT_PASSWORD=admin123

# 模型服务
SMARTCHAT_API_ENDPOINT=http://localhost:1314/api/chat
SMARTCHAT_API_TIMEOUT=120
SMARTCHAT_VISION_API_ENDPOINT=http://localhost:1314/api/generate

# RAG 向量数据库
SMARTCHAT_CHROMA_DIR=./data/chroma_db
SMARTCHAT_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh

# 文档处理（PDF 解析依赖）
# POPPLER_PATH=D:\tools\poppler\bin

# 网络代理
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
SMARTCHAT_SEARCH_TIMEOUT=15

# 其他
HF_ENDPOINT=https://hf-mirror.com
ANONYMIZED_TELEMETRY=False
